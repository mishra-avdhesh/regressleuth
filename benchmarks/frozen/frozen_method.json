  "manifest_version": 1,
  "method": {
    "adaptive_objective": "replay the unseen mask whose predicted failures split the remaining hypotheses closest to evenly (maximizes 2*p*(1-p) with p = fraction of hypotheses predicting FAIL); uniform prior, unit replay cost",
    "assumptions": [
      "replays depend only on the declared components and the run seed",
      "the evaluation cohort and labels are identical in every replay",
      "failure is monotone in the set of bad components for the true cause",
      "the cause has at most two components"
    ],
    "audit": {
      "budget": "separate from the isolation budget; failure to complete the audit yields status inferred; any contradiction yields assumption_violated",
      "default": "full",
      "masks": "complement of the all-bad state minus each cause component (expected pass), and the cause plus each one other component (expected fail)"
    },
    "budget_semantics": "budget counts both endpoint replays, search replays and minimality-verification replays; the audit is extra and reported separately; a replay is one mask evaluation regardless of repeats",
    "cause_model": "one deterministic, inclusion-minimal conjunction: F(S) is true exactly when h is a subset of S",
    "elimination": "a pass or fail outcome removes every hypothesis predicting the other outcome; inconclusive, incompatible and error outcomes prune nothing",
    "endpoint_rules": "F(empty) false and F(all-bad) true must hold, else the result is invalid_baseline or evaluation error",
    "hypothesis_space": {
      "description": "all singletons and all pairs of changed components",
      "max_cause_size": 2
    },
    "name": "regressleuth adaptive search (0.1.0a1 default configuration)",
    "regression_rule": {
      "default_confidence": 0.95,
      "default_repeats": 1,
      "deterministic": "FAIL when sign*(mean(good)-mean(mask)) >= threshold - 1e-12 else PASS",
      "noisy": "FAIL if effect - z*se >= threshold; PASS if effect + z*se < threshold; else inconclusive (more runs up to max_repeats)",
      "tolerance": 1e-12
    },
    "tie_break": "smaller mask first, then lexicographic order of sorted component names",
    "verification": "unique hypothesis whose own mask failed and whose proper subsets all passed"
  },
  "package_version": "0.1.0a1",
  "rule": "No tuning of the method using any result from the holdout benchmark. A failing holdout incident is reported, not fixed.",
