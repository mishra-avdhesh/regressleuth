{
  "id": "text_truncation",
  "good": {
    "model": "distilbert/distilbert-base-uncased-finetuned-sst-2-english",
    "preprocessing": "identity",
    "max_length": "128",
    "policy": "threshold-0.50",
    "tokenizer": "lowercasing"
  },
  "bad": {
    "model": "distilbert/distilbert-base-uncased-finetuned-sst-2-english",
    "preprocessing": "strip-punctuation",
    "max_length": "6",
    "policy": "threshold-0.60",
    "tokenizer": "lowercasing"
  },
  "replay": {
    "command": [
      "{python}",
      "../../examples/real_text/runner.py",
      "--state",
      "{state}",
      "--result",
      "{result}"
    ],
    "cases": "../../examples/real_text/cases.json",
    "metric": "accuracy",
    "direction": "higher",
    "regression_threshold": 0.1,
    "timeout_seconds": 600
  }
}
