{
  "id": "tabular_model_x_column_order",
  "good": {
    "model": "lr_v1",
    "preprocessing": "canonical-order",
    "policy": "threshold-0.50",
    "data": "snapshot-a"
  },
  "bad": {
    "model": "gbm_v2",
    "preprocessing": "alphabetical-order",
    "policy": "threshold-0.45",
    "data": "snapshot-b"
  },
  "replay": {
    "command": [
      "{python}",
      "../../examples/real_tabular/runner.py",
      "--state",
      "{state}",
      "--result",
      "{result}"
    ],
    "cases": "../../examples/real_tabular/cases.json",
    "metric": "accuracy",
    "direction": "higher",
    "regression_threshold": 0.1,
    "timeout_seconds": 60
  }
}
