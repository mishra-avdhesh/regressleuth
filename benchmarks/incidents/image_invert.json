{
  "id": "image_invert",
  "good": {
    "model": "lr_plain",
    "preprocessing": "identity",
    "data": "snapshot-a",
    "policy": "abstain-0.30"
  },
  "bad": {
    "model": "lr_plain_b",
    "preprocessing": "invert",
    "data": "snapshot-b",
    "policy": "abstain-0.10"
  },
  "replay": {
    "command": [
      "{python}",
      "../../examples/real_image/runner.py",
      "--state",
      "{state}",
      "--result",
      "{result}"
    ],
    "cases": "../../examples/real_image/cases.json",
    "metric": "accuracy",
    "direction": "higher",
    "regression_threshold": 0.1,
    "timeout_seconds": 60
  }
}
